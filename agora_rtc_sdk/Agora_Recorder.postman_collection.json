{
	"info": {
		"name": "Agora Recorder Controller",
		"description": "API Collection untuk mengontrol Agora Recording Server",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Recordings",
			"item": [
				{
					"name": "Start Recording",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"channel\": \"test_channel\",\n    \"channelKey\": \"YOUR_AGORA_TOKEN\",\n    \"uid\": \"123456\",\n    \"useProxy\": false,\n    \"participants\": [\n        {\n            \"name\": \"User A\"\n        },\n        {\n            \"name\": \"User B\"\n        }\n      ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}/start",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"start"
							]
						},
						"description": "Memulai proses rekaman untuk channel tertentu."
					},
					"response": []
				},
				{
					"name": "Stop Recording",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"sid\": \"MASUKKAN_SID_DI_SINI\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}/stop",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"stop"
							]
						},
						"description": "Menghentikan rekaman berdasarkan Session ID (SID)."
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:7070",
			"type": "string"
		}
	]
}